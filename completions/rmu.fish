# Fish completion for RMU.

complete -c rmu -s f -l force -d 'Ignore nonexistent files and never prompt'
complete -c rmu -s i -d 'Prompt before every top-level operand'
complete -c rmu -s I -d 'Prompt once for more than three operands or recursive removal'
complete -c rmu -l interactive -d 'Set prompt policy; values use --interactive=WHEN'
complete -c rmu -s d -l dir -d 'Permanently remove empty directories'
complete -c rmu -l one-file-system -d 'Refuse a directory containing nested mounts'
complete -c rmu -l no-preserve-root -d 'Disable the GNU root policy'
complete -c rmu -l preserve-root -d 'Preserve filesystem roots; use --preserve-root=all'
complete -c rmu -s r -s R -l recursive -d 'Allow directory operands'
complete -c rmu -s v -l verbose -d 'Explain successful actions'
complete -c rmu -l trash -d 'Explicitly select recoverable Trash mode'
complete -c rmu -l delegate -d 'Delegate all other arguments to GNU rm'
complete -c rmu -l rmu-progress -d 'Show rate ETA and summary; values use --rmu-progress=WHEN'
complete -c rmu -f -n 'string match -q -- "--interactive=*" (commandline -ct)' -a '--interactive=never --interactive=once --interactive=always'
complete -c rmu -f -n 'string match -q -- "--preserve-root=*" (commandline -ct)' -a '--preserve-root=all'
complete -c rmu -f -n 'string match -q -- "--rmu-progress=*" (commandline -ct)' -a '--rmu-progress=auto --rmu-progress=always --rmu-progress=never'
complete -c rmu -l help -d 'Display help and exit'
complete -c rmu -l version -d 'Display version and exit'
